# ==========================================================================
#  Elifai — Apache / LiteSpeed configuration for cPanel (public_html)
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset utf-8

# --------------------------------------------------------------------------
# 1. HTTPS + canonical host (www → apex)
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let cPanel AutoSSL / Let's Encrypt validate over plain HTTP
  RewriteCond %{REQUEST_URI} ^/\.well-known/(acme-challenge|pki-validation)/ [NC]
  RewriteRule ^ - [L]

  # Force HTTPS (works behind cPanel proxies / Cloudflare too)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.elifai.pk → elifai.pk
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------------------
  # 2. Clean URLs: /privacy serves privacy.html, /privacy.html → /privacy
  # ------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteCond %1 !^index$ [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+?)/?$ /$1.html [L]

  # Block dotfiles and repo files that may be deployed by accident
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^cache(/|$) - [F,L]
  RewriteRule ^(README\.md|LICENSE|package(-lock)?\.json|scripts/.*|.*\.sh|\.cpanel\.yml)$ - [F,L,NC]
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# --------------------------------------------------------------------------
# 3. Compression — Brotli where available, Gzip otherwise
# --------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
  <IfModule mod_setenvif.c>
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  </IfModule>
</IfModule>

# --------------------------------------------------------------------------
# 4. MIME types
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/javascript              .js .mjs
  AddType application/manifest+json    .webmanifest
  AddType image/svg+xml                .svg
  AddType image/webp                   .webp
  AddType image/avif                   .avif
  AddType font/woff2                   .woff2
</IfModule>

# --------------------------------------------------------------------------
# 5. Browser caching
#    HTML revalidates on every visit; CSS/JS for a week; images & fonts a year.
#    When you change CSS/JS, bump ?v= in index.html or wait out the week.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType application/json              "access plus 0 seconds"
  ExpiresByType application/manifest+json     "access plus 1 week"
  ExpiresByType text/css                      "access plus 1 week"
  ExpiresByType text/javascript               "access plus 1 week"
  ExpiresByType application/javascript        "access plus 1 week"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType text/xml                      "access plus 1 day"
  ExpiresByType text/plain                    "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # ------------------------------------------------------------------------
  # 6. Security headers
  # ------------------------------------------------------------------------
  # Browsers ignore HSTS on plain HTTP, and HTTP is redirected above anyway
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# PHP settings (display_errors, version) are managed per domain in
# cPanel → MultiPHP INI Editor; they are not set here so the file works
# on both Apache (PHP-FPM) and LiteSpeed (LSAPI) without a 500 error.
